[Unit]
Description=Autodesk desk automation service

[Service]
ExecStart=/usr/bin/env uv run autodesk --address 127.0.0.1 --port 7380 --config ./config/ft232h.toml --database %S/autodesk.db
KillMode=mixed
Environment="PATH=%h/.local/share/mise/shims:/usr/local/bin:/usr/bin"
WorkingDirectory=%h/code/autodesk
StateDirectory=autodesk
StateDirectoryMode=0700

[Install]
WantedBy=default.target
